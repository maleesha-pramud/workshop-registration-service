# MySQL connection. URL-encode special characters in the password (e.g. "@" -> "%40").
DATABASE_URL="mysql://root:password@localhost:3306/workshop_registration_db"

PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# First Admin account created by the seed script.
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@centre.local
SEED_ADMIN_PASSWORD=Admin@12345

# "true" also seeds a demo manager, a staff member and sample workshops (dev only; set to false in production).
SEED_DEMO=true
