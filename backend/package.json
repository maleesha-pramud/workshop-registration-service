{
  "name": "workshop-registration-backend",
  "version": "1.0.0",
  "description": "Workshop Registration Service API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "setup": "prisma migrate deploy && prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "seed": "prisma db seed",
    "lint": "oxlint src scripts prisma",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:race": "node scripts/race-test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maleesha-pramud/workshop_registration_backend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/maleesha-pramud/workshop_registration_backend/issues"
  },
  "homepage": "https://github.com/maleesha-pramud/workshop_registration_backend#readme",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^1.14.10",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "prisma": "^6.12.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=20"
  }
}
